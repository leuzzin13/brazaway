# ---- Valhalla (roteamento) ----
# Extrato OSM da Geofabrik. Para o Brasil inteiro troque por:
# https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
OSM_PBF_URL=https://download.geofabrik.de/south-america/brazil/sudeste-latest.osm.pbf
VALHALLA_PORT=8002
# Threads do build de tiles (default: nº de CPUs)
VALHALLA_THREADS=4

# ---- Postgres / PostGIS ----
POSTGRES_USER=truck
POSTGRES_PASSWORD=truck
POSTGRES_DB=truck_router
POSTGRES_PORT=5432

# ---- API ----
API_PORT=3000
# Usada pela API dentro do compose (host "db"). Para o Supabase, troque pela connection string do projeto.
DATABASE_URL=postgres://truck:truck@db:5432/truck_router
VALHALLA_URL=http://valhalla:8002
# Buffer (metros) em volta de um reporte para gerar o exclude_polygon
REPORT_BUFFER_M=25
# Raio (metros) para avisar "rota passa perto de reporte não confirmado"
WARN_RADIUS_M=100
# Fuso usado para interpretar departure_at
TZ=America/Sao_Paulo

# ---- Geocoding ----
GEOCODER_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io

# ---- Front ----
WEB_PORT=8080
